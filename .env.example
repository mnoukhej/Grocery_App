# ===================================================
# Database Configuration for Grocery Store App
# ===================================================

# Database Mode:
#   auto   - Automatically tries Direct MySQL first; if unavailable, falls back to XAMPP (Recommended)
#   xampp  - Connects using XAMPP MySQL defaults (root, empty password)
#   direct - Connects using Direct MySQL settings
DB_MODE=auto

# Host and Port (Default: 127.0.0.1:3306)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gs
DB_USER=root

# Password for Direct MySQL (Standalone MySQL server)
DB_PASSWORD=Kolkata@786

# Password for XAMPP MySQL (Default in XAMPP is empty)
XAMPP_DB_PASSWORD=
